          "dummyImgWidth": {
            "type": "integer",
            "format": "int32"
          },
          "dummyImgHeight": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "charaNum",
          "designerName",
          "dummyImgHeight",
          "dummyImgUrl",
          "dummyImgWidth",
