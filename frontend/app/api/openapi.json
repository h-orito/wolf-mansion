          "participantCount": {
            "type": "integer",
            "format": "int32"
          },
          "spectatorCount": {
            "type": "integer",
            "format": "int32"
          },
          "setting": {
            "$ref": "#/components/schemas/Setting"
          }
        },
        "required": ["id", "name", "participantCount", "setting", "spectatorCount", "status"]
