          },
          "psychicResultWolf": {
            "type": "boolean"
          },
          "noDeadByAttack": {
            "type": "boolean"
          },
          "countType": {
            "type": "string",
            "enum": ["HUMAN", "WOLF", "NO_COUNT"]
          }
        },
        "required": [
          "countType",
          "divineResultWolf",
          "noDeadByAttack",
          "psychicResultWolf",
          "skills"
        ]
      },
      "RoomAssignmentResponse": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "roomNumbers": {
            "type": "array",
