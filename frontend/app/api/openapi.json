      "RandomKeywords": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RandomKeyword"
            }
          }
        },
        "required": ["list"]
      },
      "CharachipListResponse": {
        "type": "object",
        "properties": {
          "charachips": {
            "type": "array",
