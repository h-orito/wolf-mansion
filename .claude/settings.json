{
  "permissions": {
    "deny": [
      "Edit(frontend/app/api/types.ts)",
      "Write(frontend/app/api/types.ts)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ktlint-check.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/oxlint-check.sh"
          }
        ]
      }
    ]
  }
}
